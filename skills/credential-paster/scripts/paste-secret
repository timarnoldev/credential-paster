#!/usr/bin/env bash
# paste-secret — put a secret into a file without it ever showing up in shell
# history, process arguments, terminal output or an AI agent's context.
#
# Works with bash 3.2+ (macOS) and Linux. Only needs awk and od.

set -euo pipefail
umask 077

PROG=$(basename "$0")

usage() {
  cat <<EOF
Usage:
  $PROG [SOURCE] <FILE> <KEY>
      dotenv mode: set KEY=<secret> in FILE (created if missing, mode 600)

  $PROG [SOURCE] --placeholder <MARKER> [--escape MODE] <FILE>
      any format: replace every occurrence of MARKER in FILE with the secret

  $PROG --check <FILE> <KEY>
  $PROG --check --placeholder <MARKER> <FILE>
      report status without revealing the value (exit 0 = done)

  $PROG --info
      show configured default method and which methods work here

SOURCE (default: \$PASTE_SECRET_METHOD, else hidden terminal prompt):
  -t, --tty         hidden prompt on the terminal
  -d, --dialog      native password dialog (macOS: osascript, Linux: zenity/kdialog)
  -c, --clipboard   read from clipboard, then clear it (pbpaste/wl-paste/xclip/xsel)
  -s, --stdin       read from a pipe, e.g.  op read "op://..." | $PROG -s .env KEY

Escape modes for --placeholder (default: auto):
  auto     json for *.json, dotenv for .env*, otherwise none
  none     insert raw (multi-line allowed)
  json     JSON/YAML/TOML double-quoted string content: \\ " \\n escaped (multi-line allowed)
  dotenv   complete dotenv value, quoted only if needed
  shell    complete single-quoted shell word
  url      percent-encoded (e.g. passwords inside connection URLs)

Other options:
  -k, --keep-clipboard   don't clear the clipboard after --clipboard
  -n, --no-overwrite     dotenv mode: fail if KEY already has a real value
  -h, --help             this help

The secret is never printed. Output only contains file, target and status.
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

# ------------------------------------------------------------------ args
method=${PASTE_SECRET_METHOD:-} check=0 info=0 keep_clip=0 no_overwrite=0
marker= escape=auto
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--tty)            method=tty ;;
    -d|--dialog)         method=dialog ;;
    -c|--clipboard)      method=clipboard ;;
    -s|--stdin)          method=stdin ;;
    -p|--placeholder)    [ $# -ge 2 ] || die "--placeholder needs a value"; marker=$2; shift ;;
    -e|--escape)         [ $# -ge 2 ] || die "--escape needs a value"; escape=$2; shift ;;
    -k|--keep-clipboard) keep_clip=1 ;;
    -n|--no-overwrite)   no_overwrite=1 ;;
    --check)             check=1 ;;
    --info)              info=1 ;;
    -h|--help)           usage; exit 0 ;;
    --)                  shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done; break ;;
    -*)                  die "unknown option: $1 (see --help)" ;;
    *)                   args+=("$1") ;;
  esac
  shift
done

case "${method:-tty}" in tty|dialog|clipboard|stdin) ;; *) die "unknown method '$method'" ;; esac
case "$escape" in auto|none|json|yaml|toml|dotenv|shell|url) ;; *) die "unknown escape mode '$escape'" ;; esac
case "$escape" in yaml|toml) escape=json ;; esac

# ------------------------------------------------------------------ environment probes
is_mac() { [ "$(uname -s)" = Darwin ]; }
has() { command -v "$1" >/dev/null 2>&1; }
has_tty() { { : </dev/tty; } 2>/dev/null; }
has_gui() { is_mac || [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; }
has_dialog() { has_gui && { { is_mac && has osascript; } || has zenity || has kdialog; }; }
has_clipboard() {
  { is_mac && has pbpaste; } || { [ -n "${WAYLAND_DISPLAY:-}" ] && has wl-paste; } ||
  { [ -n "${DISPLAY:-}" ] && { has xclip || has xsel; }; }
}

if [ "$info" -eq 1 ]; then
  avail=
  has_tty       && avail="$avail tty"
  has_dialog    && avail="$avail dialog"
  has_clipboard && avail="$avail clipboard"
  avail="$avail stdin"
  echo "preferred:${PASTE_SECRET_METHOD:+ $PASTE_SECRET_METHOD}${PASTE_SECRET_METHOD:- (none, set PASTE_SECRET_METHOD)}"
  echo "available:$avail"
  exit 0
fi

if [ -n "$marker" ]; then
  [ ${#args[@]} -eq 1 ] || { usage >&2; exit 2; }
  file=${args[0]} key=
  [ ${#marker} -ge 4 ] || die "placeholder must be at least 4 characters"
  case "$marker" in *$'\n'*) die "placeholder must be a single line" ;; esac
else
  [ ${#args[@]} -eq 2 ] || { usage >&2; exit 2; }
  file=${args[0]} key=${args[1]}
  printf '%s' "$key" | LC_ALL=C grep -Eq '^[A-Za-z_][A-Za-z0-9_.]*$' \
    || die "invalid key name '$key' (allowed: A-Z a-z 0-9 _ ., not starting with a digit)"
fi

if [ "$escape" = auto ]; then
  case "$(basename "$file")" in
    *.json)       escape=json ;;
    .env|.env.*|*.env) escape=dotenv ;;
    *)            escape=none ;;
  esac
fi

# ------------------------------------------------------------------ file helpers
# Raw value of the last KEY= line (an 'export ' prefix is allowed).
current_value() {
  [ -f "$file" ] || return 0
  KEY="$key" awk '
    BEGIN { k = ENVIRON["KEY"] }
    { l = $0; sub(/^[ \t]*/, "", l); sub(/^export[ \t]+/, "", l)
      if (index(l, k "=") == 1) v = substr(l, length(k) + 2) }
    END { printf "%s", v }
  ' "$file"
}

has_key_line() {
  [ -f "$file" ] && KEY="$key" awk '
    BEGIN { k = ENVIRON["KEY"]; f = 1 }
    { l = $0; sub(/^[ \t]*/, "", l); sub(/^export[ \t]+/, "", l)
      if (index(l, k "=") == 1) f = 0 }
    END { exit f }
  ' "$file"
}

count_marker() {
  M="$marker" awk '
    BEGIN { m = ENVIRON["M"]; n = 0 }
    { s = $0; while ((i = index(s, m)) > 0) { n++; s = substr(s, i + length(m)) } }
    END { print n }
  ' "$file"
}

is_placeholder_value() {
  local v=$1
  v=${v#\"}; v=${v%\"}; v=${v#\'}; v=${v%\'}
  case "$v" in
    ""|"<"*">"|"{{"*"}}"|"__"*"__"|your_*|YOUR_*|changeme|CHANGEME|xxx*|XXX*|TODO|...|REPLACE_ME) return 0 ;;
  esac
  return 1
}

# ------------------------------------------------------------------ --check
if [ "$check" -eq 1 ]; then
  [ -f "$file" ] || { echo "MISSING: $file does not exist"; exit 1; }
  if [ -n "$marker" ]; then
    n=$(count_marker)
    if [ "$n" -gt 0 ]; then echo "PENDING: placeholder found $n time(s) in $file"; exit 1; fi
    echo "DONE: no placeholder left in $file"; exit 0
  fi
  if ! has_key_line; then echo "MISSING: $key not in $file"; exit 1; fi
  v=$(current_value)
  if is_placeholder_value "$v"; then echo "EMPTY: $key in $file is empty or a placeholder"; exit 1; fi
  echo "SET: $key in $file"; exit 0
fi

# ------------------------------------------------------------------ preconditions
if [ -n "$marker" ]; then
  [ -f "$file" ] || die "$file does not exist – create it with the placeholder first"
  [ "$(count_marker)" -gt 0 ] || die "placeholder not found in $file"
else
  dir=$(dirname "$file")
  [ -d "$dir" ] || die "directory $dir does not exist"
  if [ "$no_overwrite" -eq 1 ] && has_key_line && ! is_placeholder_value "$(current_value)"; then
    die "$key already set in $file (--no-overwrite)"
  fi
fi

# ------------------------------------------------------------------ read secret
target_desc() { if [ -n "$marker" ]; then printf 'secret for %s' "$file"; else printf '%s in %s' "$key" "$file"; fi; }

read_tty() {
  has_tty || die "no interactive terminal here. Use --dialog, --clipboard or --stdin."
  local v
  printf 'Paste %s (input hidden), then Enter: ' "$(target_desc)" >/dev/tty
  IFS= read -rs v </dev/tty || true
  printf '\n' >/dev/tty
  printf '%s' "$v"
}

read_dialog() {
  local msg="Paste $(target_desc)"
  if is_mac && has osascript; then
    # Message is passed as argv, never interpolated into the AppleScript source.
    osascript - "$msg" 2>/dev/null <<'APPLESCRIPT' || die "dialog cancelled"
on run argv
  set r to display dialog (item 1 of argv) with title "paste-secret" default answer "" with hidden answer buttons {"Cancel", "OK"} default button "OK" cancel button "Cancel" with icon caution
  return text returned of r
end run
APPLESCRIPT
  elif has_gui && has zenity; then
    zenity --password --title="paste-secret: $msg" 2>/dev/null || die "dialog cancelled"
  elif has_gui && has kdialog; then
    kdialog --title paste-secret --password "$msg" 2>/dev/null || die "dialog cancelled"
  else
    die "no dialog available (needs macOS, or zenity/kdialog with a display). Use --clipboard or --tty."
  fi
}

read_clipboard() {
  if is_mac && has pbpaste; then pbpaste
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && has wl-paste; then wl-paste --no-newline
  elif has xclip; then xclip -selection clipboard -o
  elif has xsel; then xsel --clipboard --output
  else die "no clipboard tool found (pbpaste, wl-paste, xclip or xsel)"
  fi
}

clear_clipboard() {
  if is_mac && has pbcopy; then printf '' | pbcopy
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && has wl-copy; then wl-copy --clear
  elif has xclip; then printf '' | xclip -selection clipboard
  elif has xsel; then xsel --clipboard --clear
  fi
}

case "${method:-tty}" in
  tty)       value=$(read_tty) ;;
  dialog)    value=$(read_dialog) ;;
  clipboard) value=$(read_clipboard) ;;
  stdin)     [ -t 0 ] && die "--stdin expects a pipe, not a terminal"; value=$(cat) ;;
esac

# Strip surrounding whitespace / newlines (typical when copying).
value=$(printf '%s' "$value" | awk 'BEGIN { RS = "\001" }
  { sub(/^[ \t\r\n]+/, ""); sub(/[ \t\r\n]+$/, ""); printf "%s", $0 }')

[ -n "$value" ] || die "empty value – nothing written"

multiline=0
case "$value" in *$'\n'*|*$'\r'*) multiline=1 ;; esac
if printf '%s' "$value" | tr -d '\t\r\n' | LC_ALL=C grep -q '[[:cntrl:]]'; then
  die "value contains control characters – nothing written"
fi
if [ "$multiline" -eq 1 ] && { [ -z "$marker" ] || ! { [ "$escape" = none ] || [ "$escape" = json ]; }; }; then
  die "multi-line values only work with --placeholder and --escape none|json"
fi

# ------------------------------------------------------------------ escaping
escape_dotenv() {
  local v=$1
  if printf '%s' "$v" | LC_ALL=C grep -Eq '^[A-Za-z0-9_./:+=@,%~-]+$'; then
    printf '%s' "$v"; return
  fi
  v=${v//\\/\\\\}; v=${v//\"/\\\"}; v=${v//\$/\\\$}; v=${v//\`/\\\`}
  printf '"%s"' "$v"
}

escape_json() {
  local v=$1
  v=${v//\\/\\\\}; v=${v//\"/\\\"}
  v=${v//$'\t'/\\t}; v=${v//$'\r'/\\r}; v=${v//$'\n'/\\n}
  printf '%s' "$v"
}

escape_shell() {
  # Variables in the pattern avoid bash 3.2 quoting bugs inside ${//}.
  local q="'" r="'\\''"
  printf "'%s'" "${1//$q/$r}"
}

escape_url() {
  local h d
  printf '%s' "$1" | od -An -v -tx1 | tr -s ' \n' '\n\n' | while read -r h; do
    [ -n "$h" ] || continue
    d=$((16#$h))
    # RFC 3986 unreserved: 0-9 A-Z a-z - . _ ~
    if (( (d >= 48 && d <= 57) || (d >= 65 && d <= 90) || (d >= 97 && d <= 122) ||
          d == 45 || d == 46 || d == 95 || d == 126 )); then
      printf "\\x$h"
    else
      printf '%%%s' "$(printf '%s' "$h" | tr a-f A-F)"
    fi
  done
}

if [ -n "$marker" ]; then
  case "$escape" in
    none)   formatted=$value ;;
    json)   formatted=$(escape_json "$value") ;;
    dotenv) formatted=$(escape_dotenv "$value") ;;
    shell)  formatted=$(escape_shell "$value") ;;
    url)    formatted=$(escape_url "$value") ;;
  esac
else
  formatted=$(escape_dotenv "$value")
fi
unset value

# ------------------------------------------------------------------ write
[ -f "$file" ] || : >"$file"
tmp=$(mktemp "${TMPDIR:-/tmp}/paste-secret.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# The secret reaches awk via the environment, never via argv (invisible in `ps`).
if [ -n "$marker" ]; then
  M="$marker" VAL="$formatted" awk '
    BEGIN { m = ENVIRON["M"]; v = ENVIRON["VAL"] }
    { s = $0; out = ""
      while ((i = index(s, m)) > 0) { out = out substr(s, 1, i - 1) v; s = substr(s, i + length(m)) }
      print out s }
  ' "$file" >"$tmp"
else
  # Replace the last KEY= line (keeping an 'export ' prefix) or append one.
  KEY="$key" VAL="$formatted" awk '
    BEGIN { k = ENVIRON["KEY"]; v = ENVIRON["VAL"]; last = 0 }
    { lines[NR] = $0; l = $0; sub(/^[ \t]*/, "", l); pre = ""
      if (l ~ /^export[ \t]+/) { pre = "export "; sub(/^export[ \t]+/, "", l) }
      if (index(l, k "=") == 1) { last = NR; prefix = pre } }
    END { for (i = 1; i <= NR; i++) print (i == last ? prefix k "=" v : lines[i])
          if (!last) print k "=" v }
  ' "$file" >"$tmp"
fi
unset formatted

# Write in place: keeps symlinks, ownership and (in placeholder mode) permissions.
cat "$tmp" >"$file"
rm -f "$tmp"
trap - EXIT

if [ "$method" = clipboard ] && [ "$keep_clip" -eq 0 ]; then
  clear_clipboard || true
fi

if [ -n "$marker" ]; then
  echo "OK: placeholder in $file replaced (escape: $escape)."
  case "$(ls -lL "$file" | cut -c8)" in r)
    echo "WARNING: $file is readable by other users (consider: chmod 600 \"$file\")." >&2 ;;
  esac
else
  chmod 600 "$file"
  echo "OK: $key set in $file (mode 600)."
fi

# Warn if the file would be committed.
fdir=$(dirname "$file")
if has git && git -C "$fdir" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
   ! git -C "$fdir" check-ignore -q "$(basename "$file")"; then
  echo "WARNING: $file is NOT ignored by git – add it to .gitignore." >&2
fi
